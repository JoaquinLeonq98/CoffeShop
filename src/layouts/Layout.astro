---
import { ClientRouter, fade } from 'astro:transitions'
import '../styles/global.css'
import Header from "../components/ui/Header.astro";
import Footer from "../components/ui/Footer.astro";

interface Props {
	title: string
	subtitle: string
	bgImage: string
}

const { title, subtitle, bgImage } = Astro.props
/** Transición entre páginas más pausada que el fade por defecto (~180ms). */
const pageFade = fade({ duration: '0.55s' })
---

<!doctype html>
<html lang="es" transition:animate={pageFade}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Cafeteria desde 1939: {title}</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&family=PT+Sans:wght@400;700&display=swap" rel="stylesheet">
		<ClientRouter />
	</head>
	<body class="bg-coffee-100">
		<Header 
			bgImage={bgImage}
			subtitle={subtitle}
			/>
			
			<slot name="before-main-content"/>
			<main class="bg-white p-10 lg:p-20 max-w-7xl mx-auto lg:-mt-20 relative">
				<h2 class="text-coffee-900 font-black text-center text-4xl pb-10 after:coffee-icon uppercase scroll-reveal">{title}</h2>
				<slot />
			</main>
			<div class="scroll-reveal scroll-reveal-delay-2">
				<slot name="after-main-content" />
			</div>

		<Footer />

		<script src="../scripts/scroll-reveal.ts"></script>
	</body>
</html>