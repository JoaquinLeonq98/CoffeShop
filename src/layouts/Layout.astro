---
import '../styles/global.css'
import Header from '../components/UI/Header.astro'
import Footer from '../components/UI/Footer.astro'

interface Props {
	title: string
	subtitle: string
	bgImage: string
}

const { title, subtitle, bgImage } = Astro.props
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&family=PT+Sans:wght@400;700&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>Cafeteria desde 1939: {title}</title>
	</head>
	<body class="bg-coffee-100">
		<Header 
			bgImage={bgImage}
			subtitle={subtitle}
			/>
			<main class="bg-white p-20 max-w-7xl mx-auto lg:-mt-20 relative">
				<h2 class="text-coffee-900 font-black text-center text-4xl pb-10 after:coffee-icon">{title}</h2>
				<slot />
			</main>
		<Footer/>
	</body>
</html>