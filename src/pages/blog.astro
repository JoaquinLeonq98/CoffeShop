---
import BlogPosts from "../components/blog/BlogPosts.astro";
import Layout from "../layouts/Layout.astro";
import { BaseWPSchema } from "../types";
import { fixPublicIconSrcPaths } from "../utils/cms-html";

// ECMACSCRIPT 2022 Para el Manejo de promesas y consultas a APIS

const url = `${import.meta.env.API_URL}/pages?slug=blog`
const res = await  fetch(url)
const json = await res.json()
const data = BaseWPSchema.parse(json[0])
const introHtml = fixPublicIconSrcPaths(data.content.rendered)
---

<Layout
    title={data.title.rendered}
    subtitle={data.acf.subtitle}
    bgImage={data.featured_images.full.url} 
>

     <div class="text-xl space-y-3 mt-10 lg:mt-0" set:html={introHtml}></div>
     <BlogPosts/>


</Layout>
