---
import Layout from "../layouts/Layout.astro";
import { BaseWPSchema } from "../types";
import MenuPageIntro from "../components/menu/MenuPageIntro.astro";
import ProductsMenu from "../components/menu/ProductsMenu.astro";
import MenuPhotoSwipeScript from "../components/menu/MenuPhotoSwipeScript.astro";

// ECMACSCRIPT 2022 Para el Manejo de promesas y consultas a APIS
const url = `${import.meta.env.API_URL}/pages?slug=menu`;
const res = await fetch(url);
const json = await res.json();
const data = BaseWPSchema.parse(json[0]);
---

<Layout
  title={data.title.rendered}
  subtitle={data.acf.subtitle}
  bgImage={data.featured_images.full.url}
>
  <MenuPageIntro data={data} />
  <ProductsMenu slot="after-main-content" />
  <MenuPhotoSwipeScript />
</Layout>
