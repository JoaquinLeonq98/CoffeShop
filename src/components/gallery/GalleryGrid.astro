---
import { Picture } from "astro:assets";
import type { Gallery } from "../../types";
interface Props {
    gallery: Gallery[];
}

const { gallery } = Astro.props;
---

<div id='gallery' class="grid grid-cols-1 lg:grid-cols-3 gap-5">
    {
        gallery.map((image) => (
        <a 
            href={image.full.url}   
            data-pswp-width={image.full.width}
            data-pswp-height={image.full.height}
            target='_blank'
            >
                <Picture
                    src={image.large.url}
                    alt="Galeria de imágenes"
                    width={image.large.width}
                    height={image.large.height}
                    formats={["webp", "avif"]}
                />
        </a>
        ))
    }
</div>

<!-- 
--------------------------------------------------------------------------------------------
Se instala la dependencia photoswipe
Se realiza la configuración en este componente
--------------------------------------------------------------------------------------------
 -->

<script src="./gallery-grid-client.ts"></script>
