---
import type { Post } from '../../types'
import { Picture } from 'astro:assets'
import PostMeta from './PostMeta.astro'
import Postcategories from './Postcategories.astro'

interface Props {
    post: Post 
}

const { post } = Astro.props
---

<article class="grid grid-cols-1 lg:grid-cols-3 gap-3 py-10 border-b last-of-type:border-0 border-zinc-300">
    <div class="lg:col-span-2 space-y-5">
        <h3 class="text-coffee-900 font-black text-4xl uppercase">
            <a href={`/blog/${post.slug}`}>
                {post.title.rendered}
            </a>
        </h3>

       <PostMeta date={post.date}/> 

        {post.category_details.map(cat => <Postcategories name={cat.name} slug={cat.slug}/>)}

        <div class="line-clamp-2 text-lg" set:html={post.content.rendered}></div>
    </div>

    <Picture
        src={post.featured_images.medium_large.url}
        alt={`Imagen del Post: ${post.title.rendered}`}
        width={post.featured_images.medium_large.width}
        height={post.featured_images.medium_large.height}
        formats={[ 'avif', 'webp' ]}
        class="w-full lg:w-96 h-64 object-cover rounded-2xl"
    />
</article>