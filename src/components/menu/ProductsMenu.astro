---
import CoffeeMenu from "./CoffeeMenu.astro";
import FoodMenu from "./FoodMenu.astro";

---
<section class="bg-coffee-800 py-10 -mt-20" >
    <div class="max-w-7xl mx-auto bg-menu-image bg-no-repeat bg-contain bg-[center_80px] pt-[150px] lg:pt-[250px] lg:pb-20 pb-40">
        <h3 class="text-white font-black text-center text-xl uppercase">Nuestro Delicioso 
            <span class="text-4xl block text-coffee-200">Menú</span>
        </h3>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 mt-5">
            <CoffeeMenu />
            <FoodMenu />
        </div>
    </div>
</section>

<script src="./menu-photoswipe-client.ts"></script>