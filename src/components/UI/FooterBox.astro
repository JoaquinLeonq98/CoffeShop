---
interface Props {
    heading: string
}

const { heading } = Astro.props
---
<!-- 

Este componente utiliza Props y tag slot, para poder inyectar información, esta información
se coloca al usar el componente, este componente es utilizado en el Footer.

-->
<div class="text-center space-y-3">
    <h3 class="text-coffee-400 text-2xl uppercase font-black">{heading}</h3>
    <div class="space-y-3 text-xl; text-white">
        <slot/>
    </div>
</div>