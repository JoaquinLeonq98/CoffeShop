---
import type { Location } from "../../types";

interface Props {
    location: Location
}

const { location } = Astro.props

---
<div >
    <h3 class="text-coffee-900 font-black text-center text-2xl mb-5 uppercase"   >Ubicación</h3>
    <div id="map" class="h-[500px]">
        <location-data
            data-lat={location.lat}
            data-lng={location.lng}
            data-zoom={location.zoom}
            data-label={location.markers[0].label}  
            data-marketLat={location.markers[0].lat}  
            data-markerLng={location.markers[0].lng}  
        />  
    </div>
</div>
<script >
    import L from 'leaflet'
    import 'leaflet/dist/leaflet.css'

    class LocationData extends HTMLElement {
        connectedCallback() {
            const lat = this.dataset.lat
            const lng = this.dataset.lng
            const zoom = this.dataset.zoom
            const label = this.dataset.label
            const marketLat = this.dataset.marketlat
            const markerLng = this.dataset.markerlng
            
            if(lat && lng && zoom && label && marketLat && markerLng){
                const map = L.map('map').setView([+lat,+lng],+zoom);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);
            L.marker([+marketLat,+markerLng]).addTo(map)
            .bindPopup(label)
            .openPopup()
            }
        }
    }
    customElements.define('location-data', LocationData)
</script>